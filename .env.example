# Yuno API Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env file to version control

# Yuno API Keys (get these from your Yuno dashboard)
YUNO_PUBLIC_API_KEY=your_public_api_key_here
YUNO_PRIVATE_SECRET_KEY=your_private_secret_key_here

# Yuno Account ID (from your Yuno dashboard)
YUNO_ACCOUNT_ID=your_account_id_here

# API Environment (sandbox or production)
YUNO_ENVIRONMENT=sandbox

# Datadog API Keys (for querying payment logs)
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
